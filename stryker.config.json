{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "mutate": [
    "src/domain/labels.ts",
    "src/domain/discovery.ts",
    "src/domain/backup.ts",
    "src/domain/trash.ts",
    "src/domain/metadata.ts",
    "src/domain/platforms.ts"
  ],
  "vitest": {
    "configFile": "vite.config.ts",
    "related": true
  },
  "reporters": ["clear-text", "progress"],
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "cleanTempDir": "always",
  "timeoutMS": 30000,
  "timeoutFactor": 2,
  "thresholds": {
    "break": 90
  }
}
